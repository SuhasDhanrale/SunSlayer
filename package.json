{
  "name": "bamboo-slicer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mocks": "vite --open /mocks.html",
    "validate:patterns": "node scripts/validate-patterns.mjs",
    "validate:yokai": "node --loader ./scripts/json-loader.mjs scripts/validate-yokai.mjs",
    "test": "node --loader ./scripts/json-loader.mjs --test tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "package:itch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-itch.ps1",
    "build:itch": "npm run build && npm run package:itch",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "mitt": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.5.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
